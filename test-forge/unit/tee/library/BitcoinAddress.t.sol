pragma solidity ^0.8.35;

import {Test} from "forge-std/Test.sol";
import {BitcoinAddress} from "../../../../contracts/tee/library/BitcoinAddress.sol";

// Harness so the (internal) library function gets a real external entry point.
contract BitcoinAddressHarness {
    function isValid(
        string memory _address,
        BitcoinAddress.Network _network
    )
        external view
        returns (bool)
    {
        return BitcoinAddress.isValid(_address, _network);
    }
}

contract BitcoinAddressTest is Test {
    // Vectors generated by an independent reference codec (base58check + bech32/bech32m); the
    // mainnet/testnet SegWit vectors match the published BIP-173/BIP-350 test vectors.
    string internal constant P2PKH_MAIN = "1BgGZ9tcN4rm9KBzDn7KprQz87SZ26SAMH";
    string internal constant P2PKH_TEST = "mrCDrCybB6J1vRfbwM5hemdJz73FwDBC8r";
    string internal constant P2SH_MAIN = "3CNHUhP3uyB9EUtRLsmvFUmvGdjGdkTxJw";
    string internal constant P2SH_TEST = "2N3vVYSK5XRgVSGWy21PnsRmBUywSQNdCsf";
    string internal constant P2WPKH_MAIN = "bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4";
    string internal constant P2WPKH_MAIN_UPPER = "BC1QW508D6QEJXTDG4Y5R3ZARVARY0C5XW7KV8F3T4";
    string internal constant P2WPKH_TEST = "tb1qw508d6qejxtdg4y5r3zarvary0c5xw7kxpjzsx";
    string internal constant P2WPKH_REGTEST = "bcrt1qw508d6qejxtdg4y5r3zarvary0c5xw7kygt080";
    string internal constant P2WSH_MAIN = "bc1qqqqqp399et2xygdj5xreqhjjvcmzhxw4aywxecjdzew6hylgvses5wp4dt";
    string internal constant P2WSH_TEST = "tb1qqqqqp399et2xygdj5xreqhjjvcmzhxw4aywxecjdzew6hylgvsesrxh6hy";
    string internal constant P2TR_MAIN = "bc1pqqqqp399et2xygdj5xreqhjjvcmzhxw4aywxecjdzew6hylgvses7epu4h";
    string internal constant P2TR_TEST = "tb1pqqqqp399et2xygdj5xreqhjjvcmzhxw4aywxecjdzew6hylgvsesf3hn0c";
    string internal constant P2TR_REGTEST = "bcrt1pqqqqp399et2xygdj5xreqhjjvcmzhxw4aywxecjdzew6hylgvsesyga46z";
    // Structurally valid (correct checksum) but outside the accepted set, so all must be rejected:
    // v1 with a 40-byte program, a witness-v2 address, and a v0 with a non-standard 16-byte program.
    string internal constant V1_40BYTE = "bc1pqqqqp399et2xygdj5xreqhjjvcmzhxw4aywxecjdzew6hylgvseh28nkaqver9k57qpkqn";
    string internal constant V2_MAIN = "bc1zw508d6qejxtdg4y5r3zarvary0c5xw7k0w7t5p";
    string internal constant V0_16BYTE = "bc1qqqgjyv6y24n80zye42aueh0wlue5vswg";

    BitcoinAddressHarness internal harness;

    function setUp() public {
        harness = new BitcoinAddressHarness();
    }

    function _main(string memory _a) internal view returns (bool) {
        return harness.isValid(_a, BitcoinAddress.Network.Mainnet);
    }

    function _test(string memory _a) internal view returns (bool) {
        return harness.isValid(_a, BitcoinAddress.Network.Testnet);
    }

    function _regtest(string memory _a) internal view returns (bool) {
        return harness.isValid(_a, BitcoinAddress.Network.Regtest);
    }

    function testValidMainnet() public view {
        assertTrue(_main(P2PKH_MAIN));
        assertTrue(_main(P2SH_MAIN));
        assertTrue(_main(P2WPKH_MAIN));
        assertTrue(_main(P2WSH_MAIN));
        assertTrue(_main(P2TR_MAIN));
    }

    function testValidTestnet() public view {
        assertTrue(_test(P2PKH_TEST));
        assertTrue(_test(P2SH_TEST));
        assertTrue(_test(P2WPKH_TEST));
        assertTrue(_test(P2WSH_TEST));
        assertTrue(_test(P2TR_TEST));
    }

    function testValidRegtest() public view {
        assertTrue(_regtest(P2WPKH_REGTEST));
        assertTrue(_regtest(P2TR_REGTEST));
    }

    function testUppercaseBech32Accepted() public view {
        // BIP-173 permits all-uppercase (the FDC verifier accepts it too); only mixed case is invalid.
        assertTrue(_main(P2WPKH_MAIN_UPPER));
    }

    function testNetworkMismatchRejected() public view {
        assertFalse(_test(P2PKH_MAIN));
        assertFalse(_test(P2WPKH_MAIN));
        assertFalse(_main(P2WPKH_TEST));
        assertFalse(_main(P2WPKH_REGTEST));
        assertFalse(_regtest(P2TR_MAIN));
        // legacy testnet bytes are shared by regtest, so a testnet legacy address is accepted on regtest
        assertTrue(_regtest(P2PKH_TEST));
    }

    function testFutureWitnessVersionRejected() public view {
        assertFalse(_main(V2_MAIN)); // witness v2
        assertFalse(_main(V1_40BYTE)); // taproot must be 32 bytes
        assertFalse(_main(V0_16BYTE)); // v0 must be 20 (P2WPKH) or 32 (P2WSH) bytes
    }

    function testMalformedRejected() public view {
        assertFalse(_main("")); // empty
        assertFalse(_main("1BgGZ9tcN4rm9KBzDn7KprQz87SZ26SAMG")); // tampered base58 checksum
        assertFalse(_main("1BgGZ9tcN4rm9KBzDn7KprQz87SZ26SAM0")); // '0' not in base58 alphabet
        assertFalse(_main("bc1Qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4")); // mixed case
        assertFalse(_main("bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t5")); // tampered bech32 checksum
        assertFalse(_main("bc1")); // too short / no data
    }
}
