pragma solidity ^0.8.35;

import {Test} from "forge-std/Test.sol";
import {DogecoinAddress} from "../../../../contracts/tee/library/DogecoinAddress.sol";

contract DogecoinAddressHarness {
    function isValid(
        string memory _address,
        bool _testnet
    )
        external view
        returns (bool)
    {
        return DogecoinAddress.isValid(_address, _testnet);
    }
}

contract DogecoinAddressTest is Test {
    // Vectors generated by an independent reference base58check codec.
    string internal constant P2PKH_MAIN = "DFpN6QqFfUm3gKNaxN6tNcab1FArL9cZLE";
    string internal constant P2SH_MAIN = "A37YDYSwz3438rFtm1SLVcQHyD7JeueC9H";
    string internal constant P2PKH_TEST = "nesRpRaAbTDmZHwmzBkLd2AtF7Z9L9z5S2";
    string internal constant P2SH_TEST = "2N3vVYSK5XRgVSGWy21PnsRmBUywSQNdCsf";

    DogecoinAddressHarness internal harness;

    function setUp() public {
        harness = new DogecoinAddressHarness();
    }

    function _main(string memory _a) internal view returns (bool) {
        return harness.isValid(_a, false);
    }

    function _test(string memory _a) internal view returns (bool) {
        return harness.isValid(_a, true);
    }

    function testValidMainnet() public view {
        assertTrue(_main(P2PKH_MAIN));
        assertTrue(_main(P2SH_MAIN));
    }

    function testValidTestnet() public view {
        assertTrue(_test(P2PKH_TEST));
        assertTrue(_test(P2SH_TEST));
    }

    function testNetworkMismatchRejected() public view {
        assertFalse(_test(P2PKH_MAIN));
        assertFalse(_main(P2PKH_TEST));
    }

    function testForeignChainRejected() public view {
        // A Bitcoin mainnet P2PKH (version 0x00) is not a valid Dogecoin address.
        assertFalse(_main("1BgGZ9tcN4rm9KBzDn7KprQz87SZ26SAMH"));
    }

    function testMalformedRejected() public view {
        assertFalse(_main("")); // empty
        assertFalse(_main("DFpN6QqFfUm3gKNaxN6tNcab1FArL9cZLF")); // tampered checksum
        assertFalse(_main("DFpN6QqFfUm3gKNaxN6tNcab1FArL9cZL0")); // '0' not in base58 alphabet
    }
}
