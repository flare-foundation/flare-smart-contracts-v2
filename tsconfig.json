{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["ES2024"],
    "module": "Node20",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "outDir": "dist",
    "typeRoots": ["node_modules/@types", "lib/types"]
  },
  "include": [
    "./deployment",
    "./typechain-types",
    "./typechain",
    "./typechain-truffle",
    "./typechain-web3",
    "./test",
    "./scripts/libs",
    "./lib",
    "types"
  ],
  "files": ["./hardhat.config.ts"]
}
