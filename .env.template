# Insert relevant keys for deployment
SUBMISSION_DEPLOYER_PRIVATE_KEY=<insert private key in form 0x...>
# For the relay forge deploys (pnpm deploy_relay) this is only the FALLBACK signer: omit it when
# passing --ledger / --trezor / --account <name> / --gcp to the wrapper (pair those with
# --sender <expectedDeployer>). Only key-signed broadcasts require it.
DEPLOYER_PRIVATE_KEY=<insert private key in form 0x...>

# Relay forge-deploy signer alternatives (all optional — see deployment/chain-config/relay/README.md)
# Foundry keystore via env (equivalent to --account <name>; created with `cast wallet import`):
# ETH_KEYSTORE=<path to keystore file>              # or:
# ETH_KEYSTORE_ACCOUNT=<name in ~/.foundry/keystores>
# ETH_PASSWORD=<path to the keystore password file>
# Google Cloud KMS (used with the --gcp flag):
# GCP_PROJECT_ID=<project>
# GCP_LOCATION=<location>
# GCP_KEY_RING=<key ring>
# GCP_KEY_NAME=<key name>
# GCP_KEY_VERSION=<key version>

# Per-network RPC URLs for the relay forge deploys (name uppercased, '-' -> '_'):
# FLARE_RPC=<https url>
# SONGBIRD_RPC=<https url>
# COSTON_RPC=<https url>
# COSTON2_RPC=<https url>
# ARBITRUM_RPC=<https url>
# ARBITRUM_SEPOLIA_RPC=<https url>
GENESIS_GOVERNANCE_PRIVATE_KEY=0x50777f5a3ce16445e63411bf1e865a2a11d5ca3c4cbc1de00808a52180bd8d3c
GOVERNANCE_PRIVATE_KEY=<insert private key when claiming governance in form 0x...>
GOVERNANCE_PUBLIC_KEY=<insert public key when turning over governance in form 0x...>
GOVERNANCE_EXECUTOR_PUBLIC_KEY=<insert public key for executor in form 0x...>
INITIAL_VOTER_PRIVATE_KEY=<insert private key for initial voter in form 0x...>

OLD_CONTRACTS_PATH=<insert path to old contracts addresses>

# For simulation testing on staging
ACCOUNT_WITH_FUNDS_PRIVATE_KEY=<insert private key in form 0x...>
ENTITIES_FILE_PATH=<insert path to entities file>
CHAIN_CONFIG=<chain name>

# Simulation run parameters
# Voting epoch duration in seconds
VOTING_EPOCH_DURATION_SEC=20
# Reward epoch duration in voting epochs
REWARD_EPOCH_DURATION_IN_VOTING_EPOCHS=5
# All addresses should be voter signing policy key addresses
SKIP_VOTER_REGISTRATION_SET=add1,add2,add3
SKIP_SIGNING_POLICY_SIGNING_SET=add1,add2,add3
# Will skip submission transactions during voting rounds
SKIP_VOTING_EPOCH_ACTIONS=true
# Will skip finalization during voting rounds
SKIP_FINALIZATIONS=true