{
  "name": "flare-smart-contracts-v2",
  "version": "1.2.0",
  "description": "Smart contracts implementing Top level protocol on Flare Network.",
  "main": "",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/flarenetwork/flare-smart-contracts-v2.git"
  },
  "engines": {
    "node": ">=24"
  },
  "author": "Flare SC team",
  "license": "MIT",
  "directories": {},
  "scripts": {
    "---------TEST---SCRIPTS": "",
    "test": "forge test -vvv",
    "test_unit_hh": "env TEST_PATH=./test/unit hardhat test --network hardhat",
    "test_integration_hh": "env TEST_PATH=./test/integration hardhat test --network hardhat",
    "coverage": "env COVERAGE=\"true\" NODE_OPTIONS=\"--max-old-space-size=8192\" hardhat coverage --solcoverjs ./.solcover.js --testfiles \"test\"",
    "coverage-forge": "forge build && env FOUNDRY_PROFILE=\"coverage\" forge coverage --report lcov && node scripts/forge-lcov-prune.js && genhtml lcov.info.pruned --branch-coverage --output-dir coverage-forge",
    "---------COMPILE---SCRIPTS": "",
    "build": "forge build",
    "clean": "env rm -rf cache artifacts cache-forge artifacts-forge dist typechain typechain-truffle typechain-web3",
    "clean-all": "pnpm clean && env rm -rf node_modules",
    "compile": "pnpm hardhat compile && pnpm typechain-ethers-v6 && pnpm typechain-truffle-v5 && pnpm typechain-web3-v1",
    "typechain-ethers-v6": "pnpm typechain --target=ethers-v6 --out-dir typechain \"artifacts/!(build-info)/**/+([a-zA-Z0-9_]).json\" 1> null",
    "typechain-truffle-v5": "pnpm typechain --target=truffle-v5 --out-dir typechain-truffle \"artifacts/!(build-info)/**/+([a-zA-Z0-9_]).json\" 1> null",
    "typechain-web3-v1": "pnpm typechain --target=web3-v1 --out-dir typechain-web3 \"artifacts/!(build-info)/**/+([a-zA-Z0-9_]).json\" 1> null",
    "lint:check": "eslint \"{deployment,scripts,test}/**/*.ts\"",
    "lint:fix": "eslint \"{deployment,scripts,test}/**/*.ts\" --fix",
    "lint-sol": "pnpm lint-sol-contracts && pnpm lint-sol-test && pnpm lint-sol-deployment",
    "lint-sol-contracts": "solhint \"contracts/**/*.sol\"",
    "lint-sol-test": "solhint \"test-forge/**/*.sol\"",
    "lint-sol-deployment": "solhint \"deployment/**/*.sol\"",
    "format:check": "prettier --check \"{deployment,scripts,test}/**/*.{ts,js}\" hardhat.config.ts",
    "format:fix": "prettier --write \"{deployment,scripts,test}/**/*.{ts,js}\" hardhat.config.ts",
    "typechain-prepare": "env bash scripts/remove-flattened-duplicates.sh",
    "flatten-flare-sc": "pnpm flatten-dependencies node_modules/flare-smart-contracts scripts/flatten-files.txt flattened/FlareSmartContracts.sol scripts/flatten-extra-imports.txt",
    "flatten-dependencies": "env bash scripts/flatten-dependencies.sh",
    "slither": "pip3 install slither-analyzer && rm -f ./slither.json && rm -f ./slither_badge.json 2> /dev/null; slither . --json=./slither.json 2> /dev/null || true; node scripts/slither-parse.js ./slither.json",
    "generate-parameter-schema": "typescript-json-schema deployment/chain-config/tsconfig.schema.json ChainParameters -o deployment/chain-config/chain-parameters.json --noExtraProps --required --strictNullChecks",
    "---------DEPLOY---SCRIPTS": "",
    "deploy_submission_contract_network_flare": "env CHAIN_CONFIG=flare hardhat --network flare deploy-submission-contract",
    "deploy_submission_contract_network_coston2": "env CHAIN_CONFIG=coston2 hardhat --network coston2 deploy-submission-contract",
    "deploy_submission_contract_network_songbird": "env CHAIN_CONFIG=songbird hardhat --network songbird deploy-submission-contract",
    "deploy_submission_contract_network_coston": "env CHAIN_CONFIG=coston hardhat --network coston deploy-submission-contract",
    "deploy_submission_contract_local_scdev": "env CHAIN_CONFIG=scdev hardhat --network scdev deploy-submission-contract",
    "deploy_submission_contract_local_hardhat": "env CHAIN_CONFIG=scdev hardhat --network localhost deploy-submission-contract",
    "deploy_contracts_network_flare": "env CHAIN_CONFIG=flare hardhat --network flare deploy-contracts",
    "deploy_contracts_network_coston2": "env CHAIN_CONFIG=coston2 hardhat --network coston2 deploy-contracts",
    "deploy_contracts_network_songbird": "env CHAIN_CONFIG=songbird hardhat --network songbird deploy-contracts",
    "deploy_contracts_network_coston": "env CHAIN_CONFIG=coston hardhat --network coston deploy-contracts",
    "deploy_contracts_local_scdev": "env CHAIN_CONFIG=scdev hardhat --network scdev deploy-contracts",
    "deploy_contracts_local_hardhat": "env CHAIN_CONFIG=scdev hardhat --network localhost deploy-contracts",
    "daemonize_contracts_local_scdev": "env CHAIN_CONFIG=scdev hardhat --network scdev daemonize-contracts",
    "daemonize_contracts_local_hardhat": "env CHAIN_CONFIG=scdev hardhat --network localhost daemonize-contracts",
    "set_inflation_receivers_local_scdev": "env CHAIN_CONFIG=scdev hardhat --network scdev set-inflation-receivers",
    "set_inflation_receivers_local_hardhat": "env CHAIN_CONFIG=scdev hardhat --network localhost set-inflation-receivers",
    "switch_to_production_mode_network_flare": "env CHAIN_CONFIG=flare hardhat --network flare switch-to-production-mode",
    "switch_to_production_mode_network_coston2": "env CHAIN_CONFIG=coston2 hardhat --network coston2 switch-to-production-mode",
    "switch_to_production_mode_network_songbird": "env CHAIN_CONFIG=songbird hardhat --network songbird switch-to-production-mode",
    "switch_to_production_mode_network_coston": "env CHAIN_CONFIG=coston hardhat --network coston switch-to-production-mode",
    "switch_to_production_mode_local_scdev": "env CHAIN_CONFIG=scdev hardhat --network scdev switch-to-production-mode",
    "switch_to_production_mode_local_hardhat": "env CHAIN_CONFIG=scdev hardhat --network localhost switch-to-production-mode",
    "full_deploy_local_scdev": "pnpm compile && pnpm deploy_submission_contract_local_scdev && pnpm deploy_contracts_local_scdev && pnpm set_inflation_receivers_local_scdev && pnpm daemonize_contracts_local_scdev",
    "full_deploy_local_hardhat": "pnpm compile && pnpm deploy_submission_contract_local_hardhat && pnpm deploy_contracts_local_hardhat && pnpm set_inflation_receivers_local_hardhat && pnpm daemonize_contracts_local_hardhat",
    "transfer_and_wrap_funds_network_coston2": "env CHAIN_CONFIG=coston2 hardhat --network coston2 transfer-and-wrap-funds",
    "transfer_and_wrap_funds_network_coston": "env CHAIN_CONFIG=coston hardhat --network coston transfer-and-wrap-funds",
    "transfer_and_wrap_funds_local_scdev": "env CHAIN_CONFIG=scdev hardhat --network scdev transfer-and-wrap-funds",
    "transfer_and_wrap_funds_local_hardhat": "env CHAIN_CONFIG=scdev hardhat --network localhost transfer-and-wrap-funds",
    "register_entities_network_coston2": "env CHAIN_CONFIG=coston2 hardhat --network coston2 register-entities",
    "register_entities_network_coston": "env CHAIN_CONFIG=coston hardhat --network coston register-entities",
    "register_entities_local_scdev": "env CHAIN_CONFIG=scdev hardhat --network scdev register-entities",
    "register_entities_local_hardhat": "env CHAIN_CONFIG=scdev hardhat --network localhost register-entities",
    "register_public_keys_network_coston2": "env CHAIN_CONFIG=coston2 hardhat --network coston2 register-public-keys",
    "register_public_keys_network_coston": "env CHAIN_CONFIG=coston hardhat --network coston register-public-keys",
    "register_public_keys_local_scdev": "env CHAIN_CONFIG=scdev hardhat --network scdev register-public-keys",
    "register_public_keys_local_hardhat": "env CHAIN_CONFIG=scdev hardhat --network localhost register-public-keys",
    "provide_random_number_for_initial_reward_epoch_network_flare": "env CHAIN_CONFIG=flare hardhat --network flare provide-random-number-for-initial-reward-epoch",
    "provide_random_number_for_initial_reward_epoch_network_coston2": "env CHAIN_CONFIG=coston2 hardhat --network coston2 provide-random-number-for-initial-reward-epoch",
    "provide_random_number_for_initial_reward_epoch_network_songbird": "env CHAIN_CONFIG=songbird hardhat --network songbird provide-random-number-for-initial-reward-epoch",
    "provide_random_number_for_initial_reward_epoch_network_coston": "env CHAIN_CONFIG=coston hardhat --network coston provide-random-number-for-initial-reward-epoch",
    "provide_random_number_for_initial_reward_epoch_local_scdev": "env CHAIN_CONFIG=scdev hardhat --network scdev provide-random-number-for-initial-reward-epoch",
    "provide_random_number_for_initial_reward_epoch_local_hardhat": "env CHAIN_CONFIG=scdev hardhat --network localhost provide-random-number-for-initial-reward-epoch --trigger true",
    "offer_rewards_network_flare": "env CHAIN_CONFIG=flare hardhat --network flare offer-rewards",
    "offer_rewards_network_coston2": "env CHAIN_CONFIG=coston2 hardhat --network coston2 offer-rewards",
    "offer_rewards_network_songbird": "env CHAIN_CONFIG=songbird hardhat --network songbird offer-rewards",
    "offer_rewards_network_coston": "env CHAIN_CONFIG=coston hardhat --network coston offer-rewards",
    "offer_rewards_local_scdev": "env CHAIN_CONFIG=scdev hardhat --network scdev offer-rewards",
    "offer_rewards_local_hardhat": "env CHAIN_CONFIG=scdev hardhat --network localhost offer-rewards",
    "---------REDEPLOY---SCRIPTS": "",
    "redeploy_contracts_network_flare": "env CHAIN_CONFIG=flare hardhat --network flare redeploy-contracts",
    "redeploy_contracts_network_coston2": "env CHAIN_CONFIG=coston2 hardhat --network coston2 redeploy-contracts",
    "redeploy_contracts_network_songbird": "env CHAIN_CONFIG=songbird hardhat --network songbird redeploy-contracts",
    "redeploy_contracts_network_coston": "env CHAIN_CONFIG=coston hardhat --network coston redeploy-contracts",
    "redeploy_contracts_local_scdev": "env CHAIN_CONFIG=scdev hardhat --network scdev redeploy-contracts",
    "redeploy_contracts_local_hardhat": "env CHAIN_CONFIG=scdev hardhat --network localhost redeploy-contracts",
    "redeploy_relay_network_flare": "env CHAIN_CONFIG=flare hardhat --network flare redeploy-relay",
    "redeploy_relay_network_coston2": "env CHAIN_CONFIG=coston2 hardhat --network coston2 redeploy-relay",
    "redeploy_relay_network_songbird": "env CHAIN_CONFIG=songbird hardhat --network songbird redeploy-relay",
    "redeploy_relay_network_coston": "env CHAIN_CONFIG=coston hardhat --network coston redeploy-relay",
    "redeploy_relay_local_scdev": "env CHAIN_CONFIG=scdev hardhat --network scdev redeploy-relay",
    "redeploy_relay_local_hardhat": "env CHAIN_CONFIG=scdev hardhat --network localhost redeploy-relay",
    "deploy_fdc_contracts_network_flare": "env CHAIN_CONFIG=flare hardhat --network flare deploy-fdc",
    "deploy_fdc_contracts_network_coston2": "env CHAIN_CONFIG=coston2 hardhat --network coston2 deploy-fdc",
    "deploy_fdc_contracts_network_songbird": "env CHAIN_CONFIG=songbird hardhat --network songbird deploy-fdc",
    "deploy_fdc_contracts_network_coston": "env CHAIN_CONFIG=coston hardhat --network coston deploy-fdc",
    "redeploy_contracts_tee_network_flare": "env CHAIN_CONFIG=flare hardhat --network flare redeploy-contracts-tee",
    "redeploy_contracts_tee_network_coston2": "env CHAIN_CONFIG=coston2 hardhat --network coston2 redeploy-contracts-tee",
    "redeploy_contracts_tee_network_songbird": "env CHAIN_CONFIG=songbird hardhat --network songbird redeploy-contracts-tee",
    "redeploy_contracts_tee_network_coston": "env CHAIN_CONFIG=coston hardhat --network coston redeploy-contracts-tee",
    "redeploy_contracts_tee_local_scdev": "env CHAIN_CONFIG=scdev hardhat --network scdev redeploy-contracts-tee",
    "redeploy_contracts_tee_local_hardhat": "env CHAIN_CONFIG=scdev hardhat --network localhost redeploy-contracts-tee",
    "---------TEE-FORGE-DEPLOY---SCRIPTS": "",
    "deploy_tee_contracts": "bash deployment/scripts/deploy-tee-contracts.sh",
    "tee_diamond_cut": "bash deployment/scripts/execute-tee-manager-diamond-cut.sh",
    "check_cut": "tsx deployment/scripts/check-cut-plan.ts",
    "verify_tee_contracts": "bash deployment/scripts/verify-tee-contracts.sh",
    "save_deployed_addresses": "npx tsx deployment/scripts/save-deployed-addresses.ts",
    "---------SIMULATION---SCRIPTS": "",
    "sim-node": "pnpm hardhat node",
    "sim-run": "pnpm hardhat run-simulation --network local",
    "sim-sign": "pnpm hardhat run scripts/libs/mock/run-signer-emulators.ts --network local",
    "sim-fin": "pnpm hardhat run scripts/libs/mock/run-mock-finalizer.ts --network local",
    "---------ADDRESS-UPDATER-CHECK---SCRIPTS": "",
    "check_address_updater_flare": "env CHAIN_CONFIG=flare hardhat check-address-updater --network flare",
    "check_address_updater_coston2": "env CHAIN_CONFIG=coston2 hardhat check-address-updater --network coston2",
    "check_address_updater_songbird": "env CHAIN_CONFIG=songbird hardhat check-address-updater --network songbird",
    "check_address_updater_coston": "env CHAIN_CONFIG=coston hardhat check-address-updater --network coston"
  },
  "dependencies": {
    "@flarenetwork/flare-periphery-contracts": "0.1.38",
    "@openzeppelin/contracts": "5.6.1",
    "ethers": "^6.11.1",
    "flare-smart-contracts": "git+https://gitlab.com/flarenetwork/flare-smart-contracts.git",
    "hardhat": "2.28.6",
    "solhint": "^6.0.1"
  },
  "devDependencies": {
    "@coverage.rocks/genhtml": "^1.16.0",
    "@eslint/compat": "^1.3.0",
    "@eslint/js": "^9.33.0",
    "@flarenetwork/eslint-config-flare": "^0.0.2",
    "@flarenetwork/prettier-config-flare": "^0.0.3",
    "@gnosis.pm/mock-contract": "^4.0.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.6",
    "@nomicfoundation/hardhat-ethers": "^3.0.5",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.10",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-truffle5": "^2.0.7",
    "@nomiclabs/hardhat-web3": "^2.0.0",
    "@openzeppelin/test-helpers": "^0.5.16",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@typechain/truffle-v5": "7.0.0",
    "@typechain/web3-v1": "^6.0.7",
    "@types/chai": "^4.3.13",
    "@types/elliptic": "^6.4.18",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.29",
    "elliptic": "^6.5.5",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.8",
    "glob": "11.0.3",
    "intercept-stdout": "0.1.2",
    "pascal-case": "^3.1.2",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.3.1",
    "solidity-coverage": "^0.8.11",
    "sqlite3": "^5.1.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typechain": "^8.3.2",
    "typeorm": "^0.3.20",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0",
    "typescript-json-schema": "^0.63.0",
    "web3": "1.10.4",
    "web3-utils": "1.10.4",
    "winston": "^3.12.0"
  },
  "prettier": "@flarenetwork/prettier-config-flare",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
